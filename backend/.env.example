# Copy to .env and fill in the local development values.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=cosmetics_management

# Set a unique random value of at least 32 bytes.
STAFF_JWT_SECRET=

DELIVERY_JWT_SECRET=

# Optional: comma-separated allowed web application origins.
CORS_ALLOWED_ORIGINS=
